# Yönetim paneli şifresi (zorunlu — canlıya almadan önce değiştir)
ADMIN_PASSWORD=degistir-beni
# Oturum imzası için uzun rastgele bir değer (boşsa data/ içinde otomatik üretilir)
SESSION_SECRET=
# Site kök adresi (sitemap, canonical, OG için)
SITE_URL=http://localhost:3000
# AI anahtarları — alternatif olarak Admin > AI & API sayfasından da girilebilir
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
